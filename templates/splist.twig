{% set pagetitle = 'Available applications'|trans %}
{% extends "base.twig" %}

{% block preload %}
    <link rel="stylesheet" href="{{ asset('resources/style.css', 'startpage') }}">
{% endblock %}

{% block content %}
    <h2 class="sp-header">
        {% if config.pageTitle != '' %}
            {{ config.pageTitle }}
        {% else %}
            {{ 'Available applications'|trans }}
        {% endif %}
    </h2>

    {% if config.pageSubtitle != '' %}
        <p>{{ config.pageSubtitle }}</p>
    {% endif %}

    {% if config.showLogout and logout_url %}
        <div id="sp-logout">
            <a href="{{ logout_url }}">{{ 'Logout'|trans }} {{ username }}</a>
        </div>
    {% endif %}

    <div id="sp-listing">
        {% for sp in spl %}
            <div class="sp-block">
                <div class="sp-block-image">
                    <a class="sp-block-image-link" href="{{ sp.link }}">
                        <img src="{{ sp.logo }}" alt="{{ sp.name }}">
                    </a>
                </div>
                <div class="sp-block-title">
                    {{ sp.name }}
                </div>
            </div>
        {% endfor %}
    </div>
    <div class="sp-clear"></div>
{% endblock %}
